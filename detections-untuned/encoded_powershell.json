{
  "id": "ps-encoded-command",
  "title": "PowerShell encoded command",
  "level": "high",
  "attack": ["T1059.001"],
  "description": "powershell.exe invoked with -EncodedCommand / -enc, the classic obfuscated-payload launcher.",
  "logsource": {"source": "Sysmon"},
  "detection": {
    "selection": {
      "event_id": 1,
      "Image|endswith": "\\powershell.exe"
    },
    "enc": {"CommandLine|re": "\\s-e(nc(odedcommand)?)?\\s+[A-Za-z0-9+/]{40,}"},
    "condition": "selection and enc"
  }
}
