{
  "id": "lateral-rdp-external",
  "title": "RDP logon from external address",
  "level": "high",
  "attack": ["T1021.001"],
  "description": "Interactive RDP logon (LogonType 10) sourced from a non-RFC1918 address.",
  "logsource": {"source": "Security"},
